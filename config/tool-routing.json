{
  "schema": "pixelasset/tool-routing-v1",
  "selection_mode": "auto",
  "supported_modes": [
    "auto",
    "manual",
    "approve"
  ],
  "user_named_tool_is_exclusive": true,
  "must_explain_selection": true,
  "must_check_installation_and_dependencies": true,
  "max_primary_tools_per_task": 1,
  "allow_optional_postprocess_only_when_needed": true,
  "approval_required_for": [
    "paid_api",
    "external_upload",
    "image_or_video_model_call_with_unknown_entitlement",
    "tool_substitution_when_user_named_one",
    "changing_original_references",
    "overwriting_upstream_source"
  ],
  "auto_alternates_only_within_approved_constraints": true,
  "routes": {
    "static_sprite": [
      "pixelbolt",
      "codixel",
      "sprite-gen"
    ],
    "reference_to_sprite": [
      "codixel",
      "sprite-gen",
      "pixelbolt"
    ],
    "existing_character_animation": [
      "codixel",
      "pixelbolt",
      "2dimg2motion",
      "agent-sprite-forge",
      "sprite-gen"
    ],
    "model_generated_animation": [
      "2dimg2motion",
      "agent-sprite-forge",
      "sprite-gen"
    ],
    "sprite_sheet_processing": [
      "sprite-gen",
      "codixel",
      "pixelbolt"
    ],
    "skill_vfx": [
      "pixelfx",
      "pixelbolt",
      "codixel"
    ],
    "map_or_tileset": [
      "pixelbolt",
      "agent-sprite-forge",
      "codixel"
    ],
    "high_resolution_image_pixelization": [
      "pixeloe",
      "codixel",
      "spritefusion-pixel-snapper"
    ],
    "irregular_pixel_grid_fix": [
      "spritefusion-pixel-snapper",
      "sprite-gen"
    ],
    "palette_reduction": [
      "spritefusion-pixel-snapper",
      "pixeloe",
      "sprite-gen"
    ]
  },
  "notes_ko": [
    "우선순위는 절대적인 실행 순서가 아니다. 결과 형식, 모델 가용성, 입력 종류, 해상도와 기존 에셋을 함께 판단한다.",
    "원본 도구의 스킬이 외부 Provider를 자동 호출하라고 해도 이 프로젝트의 승인 규칙이 우선한다.",
    "Code-based 작업은 생성 모델 호출로 간주하지 않는다. API/외부 이미지·영상 생성 호출은 별도 확인한다.",
    "소스가 복제돼 있는 상태와 CLI나 모델이 실제로 동작하는 상태를 구분한다."
  ]
}
